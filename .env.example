# Copy this file to `.env` and fill in your Microsoft Foundry / Azure AI Services resource details.
# Authentication uses `az login` (AzureCliCredential / DefaultAzureCredential) by default — no API key needed!

AZURE_FOUNDRY_ACCOUNT=your-foundry-account
AZURE_SPEECH_REGION=eastus2
AZURE_FOUNDRY_RESOURCE_ID=/subscriptions/00000000-0000-0000-0000-000000000000/resourceGroups/your-rg/providers/Microsoft.CognitiveServices/accounts/your-foundry-account

# Optional model overrides:
# VOICELIVE_CASCADE_MODEL=gpt-6-luna
# VOICELIVE_REALTIME_MODEL=gpt-realtime-2.1
# External listener translation uses its own exact deployment name (no guessed SKU suffix).
# DEPLOYMENT_LISTENER_TEXT=gpt-6-luna
# Use the exact deployment name in the PRIMARY resource, not a guessed SKU suffix.
# DEPLOYMENT_GPT_VISION=gpt-6.1-terra
# Alternative: gpt-6.1-sol (uses low reasoning rather than none).
# DEPLOYMENT_GPT_LIVE=gpt-live-1-test
# Optional dedicated GPT-Live resource; other engines keep using the primary resource.
# The referenced file must contain FOUNDRY_ENDPOINT, AOAI_ENDPOINT and FOUNDRY_KEY.
# GPT_LIVE_FOUNDRY_ENV_FILE=/absolute/path/foundry.live.env
# DEPLOYMENT_GPT_LIVE=your-live-deployment-name

# Optional API key fallback (leave unset when using `az login` Entra ID auth):
# AZURE_API_KEY=

# Optional local access-control storage and HTTPS deployment:
# HOST=127.0.0.1
# PORT=3210
# APP_DATA_DIR=/absolute/path/to/private-data
# COOKIE_SECURE=1
# PUBLIC_ORIGIN=https://your-domain

# Optional private, sanitized player-GSI recordings (off by default; never commit them).
# GSI_CAPTURE_DIR=/absolute/path/to/private-gsi-captures
