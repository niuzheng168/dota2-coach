<Window x:Class="DotaCoach.TwoPc.MatchReviewWindow" x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DotaCoach.TwoPc"
        Title="Dota Coach · 对局档案与复盘" WindowStartupLocation="CenterOwner"
        Width="1140" Height="800" MinWidth="760" MinHeight="565"
        Background="#0F151E" Foreground="White" FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="13">
    <Grid Margin="16,10,16,12">
    <Grid.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="9,4"/><Setter Property="Margin" Value="2"/>
            <Setter Property="Background" Value="#243343"/><Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#687D8D"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="3" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bg" Property="Background" Value="#384F61"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Bg" Property="Background" Value="#456173"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Bg" Property="Opacity" Value="0.48"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="#E2EBF2"/><Setter Property="CaretBrush" Value="White"/>
            <Setter Property="Background" Value="#111B26"/><Setter Property="BorderBrush" Value="#465866"/>
            <Setter Property="Padding" Value="6,4"/>
        </Style>
        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="White"/><Setter Property="Margin" Value="4,4,10,4"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="#101820"/><Setter Property="Padding" Value="5,3"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <WrapPanel Margin="0,0,0,6">
            <TextBlock Text="对局复盘" Foreground="#59DDBC" FontSize="24" FontWeight="SemiBold" Margin="0,0,16,0"/>
            <TextBlock Text="本机档案　/　独立查看，不回传到游戏或模型" Foreground="#BDCAD7" VerticalAlignment="Center"/>
        </WrapPanel>
        <Border Grid.Row="1" Background="#192330" CornerRadius="5" Padding="11,6">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Label Content="对局" Target="{Binding ElementName=Matches}" Foreground="White"/>
                    <ComboBox x:Name="Matches" Grid.Column="1" DisplayMemberPath="Label" MinWidth="150"
                              AutomationProperties.Name="已存档的对局"/>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="5,0">
                        <TextBlock Text="查找局号" Foreground="#C3D0DD" VerticalAlignment="Center" Margin="3,0"/>
                        <TextBox x:Name="SearchId" Width="96" MaxLength="24" ToolTip="输入对局号或其中一段" AutomationProperties.Name="查找对局号"/>
                    </StackPanel>
                    <StackPanel Grid.Column="3" Orientation="Horizontal">
                        <Button x:Name="PrevMatches" Content="‹" AutomationProperties.Name="上一页档案"/>
                        <TextBlock x:Name="MatchPage" VerticalAlignment="Center" Foreground="#C3D0DD"/>
                        <Button x:Name="NextMatches" Content="›" AutomationProperties.Name="下一页档案"/>
                    </StackPanel>
                    <Button x:Name="RefreshMatches" Grid.Column="4" Content="刷新档案"/>
                </Grid>
                <TextBlock x:Name="MatchStatus" Foreground="#C6D8E3" TextWrapping="Wrap" Margin="2,4,0,1"/>
                <WrapPanel>
                    <Button x:Name="DownloadReplay" Content="下载官方公开录像" ToolTip="仅赛后：查询公开元数据，从 Valve 录像服务器获取。不会自动下载。"/>
                    <Button x:Name="LocalReplay" Content="导入本地 .dem / .dem.bz2" ToolTip="只在本机解析，不上传原始录像。"/>
                    <Button x:Name="CancelReplay" Content="取消任务" Visibility="Collapsed"/>
                    <ProgressBar x:Name="JobProgress" Width="80" Height="9" Margin="8,0" IsIndeterminate="True" Visibility="Collapsed"/>
                </WrapPanel>
            </StackPanel>
        </Border>
        <DockPanel Grid.Row="2" Margin="0,7,0,4">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Label Content="事件类型" Target="{Binding ElementName=Filter}" Foreground="#C3D0DD"/>
                <ComboBox x:Name="Filter" Width="158" AutomationProperties.Name="筛选事件类型"/>
            </StackPanel>
            <WrapPanel>
                <RadioButton x:Name="KnownMode" GroupName="Mode" Content="当时已知" IsChecked="True"/>
                <RadioButton x:Name="ReplayMode" GroupName="Mode" Content="录像全图"/>
                <RadioButton x:Name="CompareMode" GroupName="Mode" Content="并排对照"/>
            </WrapPanel>
        </DockPanel>
        <Grid Grid.Row="3" Margin="0,0,0,8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="游戏游标" Foreground="#C3D0DD" VerticalAlignment="Center"/>
                <TextBlock x:Name="CursorLabel" MinWidth="70" Margin="7,0,4,0" FontFamily="Consolas" FontSize="20"
                           Foreground="#59DDBC" VerticalAlignment="Center"/>
                <Button x:Name="AtStart" Content="起点"/><Button x:Name="StepBack" Content="−15 秒"/>
            </StackPanel>
            <Slider x:Name="Scrubber" Grid.Column="1" VerticalAlignment="Center" Margin="10,0" IsMoveToPointEnabled="True"
                    SmallChange="1" LargeChange="15" TickFrequency="1" IsSnapToTickEnabled="True"
                    AutomationProperties.Name="对局游戏时间游标"/>
            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button x:Name="StepForward" Content="+15 秒"/><Button x:Name="AtEnd" Content="末尾"/>
            </StackPanel>
        </Grid>
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions><ColumnDefinition x:Name="KnownWidth"/><ColumnDefinition x:Name="ReplayWidth" Width="0"/></Grid.ColumnDefinitions>
            <local:MatchReviewPane x:Name="KnownPane"/>
            <local:MatchReviewPane x:Name="ReplayPane" Grid.Column="1" Visibility="Collapsed"/>
        </Grid>
        <TextBox x:Name="Notice" Grid.Row="5" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="67"
                 BorderThickness="0" Foreground="#D4E4F0" Background="#0F151E" VerticalScrollBarVisibility="Auto"
                 Margin="0,4,0,0" AutomationProperties.Name="档案和录像任务状态"/>
    </Grid>
</Window>
