{
  "name": "dota2-coach-bridge",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Low-latency real-time DOTA2 bilingual voice coaching room supporting Cascade (MAI-Transcribe + GPT + Azure TTS), gpt-realtime, and gpt-live",
  "scripts": {
    "start": "node src/server.ts",
    "dev": "node --watch src/server.ts",
    "build:dict": "node scripts/build-dota2-dictionary.ts",
    "build:heroes": "node scripts/build-hero-picker.ts",
    "build:jungle": "node scripts/build-dota2-jungle-data.ts",
    "replay:gsi": "node scripts/replay-gsi.ts",
    "report:luna": "node scripts/report-luna-scenario.ts",
    "reason:luna": "node scripts/reason-luna.ts",
    "sandbox": "node scripts/sandbox.ts",
    "sandbox:reason": "node scripts/reason-sandbox.ts",
    "sandbox:audit": "node scripts/audit-sandbox.ts",
    "map:reference": "node scripts/build-map-reference.ts",
    "map:client-audit": "node scripts/client/audit-installation.ts",
    "map:engine-probe": "node scripts/client/collect-engine.ts",
    "build:simulator": "node scripts/build-simulator-data.ts",
    "build:minimap": "node scripts/build-minimap-icons.ts",
    "replay:download": "node scripts/replays/download.ts",
    "replay:discover": "node scripts/replays/discover.ts",
    "replay:report": "node scripts/replays/report.ts",
    "replay:farming": "node scripts/replays/build-farming-routes.ts",
    "replay:study:prepare": "node scripts/replays/prepare-hundred.ts",
    "replay:study:collect": "node scripts/replays/batch-hundred.ts",
    "replay:study:review": "node scripts/replays/review-hundred.ts",
    "replay:study:analyze": "node scripts/replays/analyze-hundred.ts",
    "replay:study:publish": "node scripts/replays/publish-hundred.ts",
    "eval:domain": "node scripts/eval-dota2-translation.ts",
    "probe:compare": "node scripts/dual-gsi/compare.ts",
    "benchmark": "node src/benchmark.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.ts",
    "create-user": "node scripts/create-user.ts"
  },
  "dependencies": {
    "@azure/identity": "^4.14.1",
    "ws": "^8.22.2"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/ws": "^8.18.2",
    "typescript": "^7.0.2"
  }
}
